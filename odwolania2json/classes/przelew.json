{
  "class": "przelew",
  "threshold": 9,
  "signals": [
    {
      "name": "nagłówek_przelewu",
      "weight": 7,
      "pattern": "^[ \\t]*(?:(?:[^\\n]{0,110}\\bbank\\b[^\\n]{0,95}|Dotyczy:)[ \\t]+)?(?:POLECENIE PRZELEWU|(?:POTWIERDZENIE|DOWÓD) (?:REALIZACJI |WYKONANIA )?(?:POLECENIA )?(?:PRZELEWU|TRANSAKCJI|OPERACJI BANKOWEJ))\\b|^[ \\t]*(?:POTWIERDZENIE|DOWÓD)(?:[ \\t]*\\n[ \\t]*(?:(?:REALIZACJI|WYKONANIA)[ \\t]+)?|[ \\t]+(?:REALIZACJI|WYKONANIA)[ \\t]*\\n[ \\t]*)PRZELEWU(?:[ \\t]+KRAJOWEGO)?[ \\t]*$"
    },
    {
      "name": "rola_rachunku",
      "weight": 2,
      "pattern": "\\b(?:Rachunek (?:odbiorcy|zleceniodawcy|nadawcy|płatnika|uznawany|obciążany|beneficjenta)|[zn]a? rachun(?:ku|ek) nr)\\b"
    },
    {
      "name": "kwota_operacji",
      "weight": 2,
      "pattern": "^[ \\t]*(?:Kwota|Wartość)\\b|\\bprzelew[^\\n]{0,35} w kwocie\\b"
    },
    {
      "name": "data_operacji",
      "weight": 2,
      "pattern": "^[ \\t]*Data (?:operacji|transakcji|realizacji|wykonania|księgowania)\\b|\\bBank potwierdza, że w dniu\\b"
    },
    {
      "name": "identyfikator_transakcji",
      "weight": 2,
      "pattern": "^[ \\t]*(?:Nr ref\\.|(?:Nr|Numer|Identyfikator) (?:operacji|transakcji|referencyjny))\\b"
    }
  ],
  "schema": {
    "przelew_bankowy": {
      "data_operacji": "date?",
      "kwota": "number?",
      "tytul": "text?",
      "numer_transakcji": "text?",
      "z_rachunku": "text?",
      "na_rachunek": "text?"
    }
  },
  "fields": {
    "przelew_bankowy.data_operacji": [
      {
        "name": "data_transakcji",
        "pattern": "^[ \\t]*Data (?:operacji|transakcji|realizacji|wykonania|księgowania)[ \\t]*[:\\-]?[ \\t]*(?:\\.{2,}[ \\t]*)?(?:\\n[ \\t]*)?(<DATE>)",
        "operation": "date"
      },
      {
        "name": "data_w_treści_potwierdzenia",
        "pattern": "\\bBank potwierdza, że w dniu[ \\t]+(<DATE>)",
        "operation": "date"
      }
    ],
    "przelew_bankowy.kwota": [
      {
        "name": "kwota_operacji",
        "pattern": "^[ \\t]*(?:Kwota(?: (?:operacji|przelewu|transakcji))?|Wartość)[ \\t]*[:\\-]?[ \\t]*(?:\\.{2,}[ \\t]*)?(?:\\n[ \\t]*)?(?:PLN[ \\t]+)?([0-9][0-9 ,.\\t]*[,.][0-9]{2}|[0-9]{1,3}(?:[ \\t][0-9]{3})+|[0-9]+)(?![0-9.,])",
        "operation": "money"
      },
      {
        "name": "kwota_w_treści_potwierdzenia",
        "pattern": "\\bprzelew[^\\n\\f]{0,35} w kwocie[ \\t]+([0-9][0-9 ,.\\t]*[,.][0-9]{2}|[0-9]{1,3}(?:[ \\t][0-9]{3})+|[0-9]+)(?![0-9.,])",
        "operation": "money"
      }
    ],
    "przelew_bankowy.tytul": [
      {
        "name": "tytuł_w_cudzysłowie",
        "pattern": "^[ \\t]*(?:Tytułem|Tytuł(?: przelewu| operacji)?|Opis(?: operacji)?)[ \\t]*:?[ \\t]*(?:\\n[ \\t]*)?([„“\"][^”\"\\f]+[”\"]\\.?)",
        "operation": "title"
      },
      {
        "name": "tytuł_przelewu",
        "pattern": "^[ \\t]*(?:Tytułem|Tytuł(?: przelewu| operacji)?|Opis(?: operacji)?)(?:[ \\t]*:[ \\t]*|[ \\t]+|\\n[ \\t]*)(?:\\n[ \\t]*)?([^\\n\\f]+(?:\\n[ \\t]*(?!(?:Nr|Numer|Identyfikator|ID|Status|ZREALIZOWANO|Potwierdzenie|Data|Kwota|Wartość|Rachunek|Typ|Kanał|Waluta|Opłata|Bank)\\b|[-=_]{3})[^\\n\\f]+)*)"
      }
    ],
    "przelew_bankowy.numer_transakcji": [
      {
        "name": "numer_referencyjny_transakcji",
        "pattern": "^[ \\t]*(?:Nr ref\\.?|(?:Numer|Nr|Identyfikator|ID) (?:transakcji|operacji|referencyjny|przelewu|referencji))(?:[ \\t]+operacji)?[ \\t]*[:\\-]?[ \\t]*(?:\\.{2,}[ \\t]*)?(?:\\n[ \\t]*)?([a-z0-9][a-z0-9_./\\-]+)",
        "operation": "identifier"
      }
    ],
    "przelew_bankowy.z_rachunku": [
      {
        "name": "rachunek_z_etykiety_roli",
        "pattern": "^[ \\t]*(?:Rachunek (?:obciążany|zleceniodawcy|nadawcy|płatnika)|Z rachunku)[ \\t]*:?[ \\t]*(?:\\n[ \\t]*)?(?:PL[ \\t]*)?((?:[0-9][ \\t]*){24,26})(?![ \\t]*[0-9])",
        "operation": "digits"
      },
      {
        "name": "rachunek_w_treści_potwierdzenia",
        "pattern": "\\bz rachunku[ \\t]+(?:nr[ \\t]+)?(?:PL[ \\t]*)?((?:[0-9][ \\t]*(?:\\n[ \\t]*)?){26})(?![ \\t]*[0-9])",
        "operation": "digits"
      },
      {
        "name": "rachunek_w_sekcji_roli",
        "pattern": "^[ \\t]*(?:Płatnik|Zleceniodawca|(?:Dane )?Nadawc[ay]|Dane płatnika)\\b[^\\n\\f]*(?:\\n(?!(?:[ \\t]*(?:Beneficjent|(?:Dane )?Odbiorc[ay]|Adresat przelewu|Kwota)\\b))[^\\n\\f]*){0,5}?\\n[ \\t]*(?:PL[ \\t]*)?((?:[0-9][ \\t]*){24,26})(?![ \\t]*[0-9])[ \\t]*(?=\\n|$)",
        "operation": "digits"
      }
    ],
    "przelew_bankowy.na_rachunek": [
      {
        "name": "rachunek_z_etykiety_roli",
        "pattern": "^[ \\t]*(?:Rachunek (?:odbiorcy|uznawany|beneficjenta)|Na rachunek)[ \\t]*:?[ \\t]*(?:\\n[ \\t]*)?(?:PL[ \\t]*)?((?:[0-9][ \\t]*){24,26})(?![ \\t]*[0-9])",
        "operation": "digits"
      },
      {
        "name": "rachunek_w_treści_potwierdzenia",
        "pattern": "\\bna rachunek[ \\t]+(?:nr[ \\t]+)?(?:PL[ \\t]*)?((?:[0-9][ \\t]*(?:\\n[ \\t]*)?){26})(?![ \\t]*[0-9])",
        "operation": "digits"
      },
      {
        "name": "rachunek_w_sekcji_roli",
        "pattern": "^[ \\t]*(?:Beneficjent|(?:Dane )?Odbiorc[ay]|Adresat przelewu)\\b[^\\n\\f]*(?:\\n(?!(?:[ \\t]*(?:Kwota|Wartość|Data|Nr|Numer)\\b))[^\\n\\f]*){0,5}?\\n[ \\t]*(?:PL[ \\t]*)?((?:[0-9][ \\t]*){24,26})(?![ \\t]*[0-9])[ \\t]*(?=\\n|$)",
        "operation": "digits"
      }
    ]
  },
  "classification_pages": 1
}
