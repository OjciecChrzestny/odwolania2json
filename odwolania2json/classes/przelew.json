{
  "class": "przelew",
  "threshold": 9,
  "signals": [
    {
      "name": "nagłówek_przelewu",
      "weight": 7,
      "pattern": "^[ \\t]*(?:(?:[^\\n]{0,110}\\bbank\\b[^\\n]{0,95}|Dotyczy:)[ \\t]+)?(?:(?:POTWIERDZENIE|DOWÓD) (?:REALIZACJI |WYKONANIA )?(?:POLECENIA )?(?:PRZELEWU|TRANSAKCJI(?=[^\\f]{0,1800}(?:\\b(?:Z rachunku|Na rachunek|Rachunek (?:nadawcy|odbiorcy|obciążany|uznawany)|Data księgowania|Account number|Beneficiary account|Payer account|Booking date)\\b))|OPERACJI(?: BANKOWEJ)?))\\b|^[ \\t]*(?:POTWIERDZENIE|DOWÓD)(?:[ \\t]*\\n[ \\t]*(?:(?:REALIZACJI|WYKONANIA)[ \\t]+)?|[ \\t]+(?:REALIZACJI|WYKONANIA)[ \\t]*\\n[ \\t]*)PRZELEWU(?:[ \\t]+KRAJOWEGO)?[ \\t]*$|^[ \\t]*(?:UZNANIE|OBCIĄŻENIE)[ \\t]*/[ \\t]*POLECENIE PRZELEWU\\b|^[ \\t]*(?:(?:BANK TRANSFER|TRANSFER) CONFIRMATION|(?:TRANSACTION|PAYMENT) CONFIRMATION(?=[^\\f]{0,1800}(?:\\b(?:Z rachunku|Na rachunek|Rachunek (?:nadawcy|odbiorcy|obciążany|uznawany)|Data księgowania|Account number|Beneficiary account|Payer account|Booking date)\\b)))[ \\t]*$"
    },
    {
      "name": "rola_rachunku",
      "weight": 2,
      "pattern": "\\b(?:Rachunek (?:odbiorcy|zleceniodawcy|nadawcy|płatnika|uznawany|obciążany|beneficjenta)|[zn]a? rachun(?:ku|ek) nr)\\b|\\b(?:Z rachunku|Na rachunek|Winien \\(Nadawca\\)|Ma \\(Odbiorca\\)|Account number|Beneficiary account|Payer account)\\b"
    },
    {
      "name": "kwota_operacji",
      "weight": 2,
      "pattern": "^[ \\t]*(?:Kwota|Wartość)\\b|\\bprzelew[^\\n]{0,35} w kwocie\\b|^[ \\t]*(?:Transfer amount|Amount)\\b"
    },
    {
      "name": "data_operacji",
      "weight": 2,
      "pattern": "^[ \\t]*Data (?:operacji|transakcji|realizacji|wykonania|księgowania)\\b|\\bBank potwierdza, że w dniu\\b|^[ \\t]*(?:Date of operation|Transaction date|Execution date|Booking date)\\b"
    },
    {
      "name": "identyfikator_transakcji",
      "weight": 2,
      "pattern": "^[ \\t]*(?:Nr ref\\.|(?:Nr|Numer|Identyfikator) (?:operacji|transakcji|referencyjny))\\b"
    },
    {
      "name": "zaksięgowany_przelew",
      "weight": 5,
      "pattern": "(?=[^\\f]{0,1800}\\b(?:przelew|transfer)\\b)^[ \\t]*(?:Status(?: operacji| transakcji)?[ \\t]*:[ \\t]*(?:wykonan[ay]|zrealizowan[ay]|zaksięgowan[ay])|ZREALIZOWANO)[ \\t]*$"
    },
    {
      "name": "rachunek_i_wiersz_kwoty_z_datą",
      "weight": 2,
      "pattern": "^[ \\t]*(?:POLECENIE PRZELEWU|POTWIERDZENIE (?:WYKONANIA |REALIZACJI )?PRZELEWU)(?: KRAJOWEGO)?[ \\t]*$(?=[^\\f]{0,3500}(?<![\\w])(?:PL[ \\t]*)?(?:[0-9]{26}|[0-9]{2}(?:[ \\t]+[0-9]{4}){6})(?![\\w]))(?=[^\\f]{0,3500}\\n[ \\t]*(?:PLN[ \\t]+)?[+\\-−]?(?:[0-9]{1,3}(?:[ .][0-9]{3})+|[0-9]+)[,.][ \\t]*[0-9]{2}(?:[ \\t]*(?:PLN|zł))?[ \\t]+(?:20[0-9]{2}[-./][0-9]{1,2}[-./][0-9]{1,2}|[0-9]{1,2}[-./][0-9]{1,2}[-./]20[0-9]{2})[ \\t]*$)"
    },
    {
      "name": "polecenie_z_wartością",
      "weight": 7,
      "pattern": "^[ \\t]*(?:(?:[^\\n]{0,110}\\bbank\\b[^\\n]{0,95}|Dotyczy:)[ \\t]+)?POLECENIE PRZELEWU\\b",
      "requires": {
        "wpisana_kwota_lub_data_księgowania": "(?<![\\w.,/])[+−-]?(?:[0-9]{1,3}(?:[ .,][0-9]{3})+|[0-9]+)[,.][0-9]{2}(?![0-9.,])|^[ \\t]*Data (?:ksi(?:[ęe]|[ \\t]+)gowania|wyci[ąa]gu)[ \\t]*[:|]?[ \\t]*(?:\\n[ \\t]*){0,2}(?:[12][0-9]{3}[-./][0-9]{1,2}[-./][0-9]{1,2}|[0-9]{1,2}[-./][0-9]{1,2}[-./][12][0-9]{3})(?![0-9])"
      }
    },
    {
      "name": "rozliczona_operacja_z_danymi",
      "weight": 9,
      "pattern": "^[ \\t]*(?:Potwierdzenie (?:wykonanej|zrealizowanej) (?:operacji|transakcji)(?: bankowej)?|(?:Szczeg[óo][łl]owy )?raport z transakcji)[ \\t]*[.:]?[ \\t]*$",
      "requires": {
        "kwota_z_wartością": "^[ \\t]*(?:Kwota|Warto[śs][ćc])(?: (?:transakcji|operacji|przelewu|zaksi[ęe]gowana|obci[ąa][żz]enia))?[ \\t]*[:|]?[ \\t]*(?:\\n[ \\t]*){0,2}(?:PLN[ \\t]*)?[+−-]?(?:[0-9]{1,3}(?:[ .,][0-9]{3})+|[0-9]+)[,.][0-9]{2}(?![0-9.,])",
        "data_z_wartością": "^[ \\t]*Data (?:ksi(?:[ęe]|[ \\t]+)gowania|waluty|operacji|transakcji|wykonania|realizacji|wyci[ąa]gu)[ \\t]*[:|]?[ \\t]*(?:\\n[ \\t]*){0,2}(?:[12][0-9]{3}[-./][0-9]{1,2}[-./][0-9]{1,2}|[0-9]{1,2}[-./][0-9]{1,2}[-./][12][0-9]{3})(?![0-9])",
        "typ_przelewu_lub_rachunek_drugiej_strony": "^[ \\t]*(?:Typ (?:produktu|operacji|zlecenia)|Rodzaj (?:operacji|przelewu)|Opis (?:kodu )?(?:operacji|transakcji))[ \\t]*[:|]?[ \\t]*(?:\\n[ \\t]*){0,2}(?:PRZELEW\\w*|(?:przekaz|p[łl]atno[śs][ćc]) (?:wychodz[ąa]c\\w*|przychodz[ąa]c\\w*))\\b|^[ \\t]*(?:Rachunek (?:odbiorcy|beneficjenta|kontrahenta)|Dane (?:odbiorcy|beneficjenta|kontrahenta)(?:/zleceniodawcy)?)(?:[ !/|:\\t-]+(?:identyfikator)?)?[ \\t]*[:|]?[ \\t]*(?:\\n[ \\t]*){0,2}/?(?:PL[ \\t]*)?[0-9]{2}(?:[ \\t-]*[0-9]{4}){6}(?![0-9])",
        "księgowanie_wyciąg_lub_referencja_bankowa": "^[ \\t]*Data (?:ksi(?:[ęe]|[ \\t]+)gowania|wyci[ąa]gu)[ \\t]*[:|]?[ \\t]*(?:\\n[ \\t]*){0,2}(?:[12][0-9]{3}[-./][0-9]{1,2}[-./][0-9]{1,2}|[0-9]{1,2}[-./][0-9]{1,2}[-./][12][0-9]{3})(?![0-9])|^[ \\t]*(?:Referencje banku|(?:Nr|Numer) referencyjny)[ \\t]*[:|]?[ \\t]*(?:\\n[ \\t]*){0,2}(?=[\\w/#-]{0,24}\\d)[\\w/#-]{4,}"
      },
      "retry_ocr": true
    }
  ],
  "schema": {
    "przelew_bankowy": {
      "data_operacji": "date?",
      "kwota": "number?",
      "tytul": "text?",
      "numer_transakcji": "text?",
      "z_rachunku": "text?",
      "na_rachunek": "text?"
    }
  },
  "fields": {
    "przelew_bankowy.data_operacji": [
      {
        "name": "data_transakcji",
        "pattern": "^[ \\t]*(?:Data (?:operacji|transakcji|realizacji|wykonania)|Date of operation|Transaction date|Execution date)[ \\t]*[:\\-]?[ \\t]*(?:\\.{2,}[ \\t]*)?(?:\\n[ \\t]*)?(<DATE>)",
        "operation": "date"
      },
      {
        "name": "data_w_treści_potwierdzenia",
        "pattern": "\\bBank potwierdza, że w dniu[ \\t]+(<DATE>)",
        "operation": "date"
      },
      {
        "name": "data_zaksięgowania",
        "pattern": "^[ \\t]*(?:Data księgowania|Booking date)[ \\t]*:?[ \\t]*(?:\\n[ \\t]*)?(<DATE>)",
        "operation": "date"
      }
    ],
    "przelew_bankowy.kwota": [
      {
        "name": "kwota_operacji",
        "pattern": "^[ \\t]*(?:Kwota(?: (?:operacji|przelewu|transakcji|w walucie rachunku|obciążenia))?|Wartość|Transfer amount|Amount)[ \\t]*[:\\-]?[ \\t]*(?:\\.{2,}[ \\t]*)?(?:\\n[ \\t]*)?(?:PLN[ \\t]+)?[+−\\-]?[ \\t]*([0-9][0-9 ,.\\t]*[,.][0-9]{2}|[0-9]{1,3}(?:[ \\t][0-9]{3})+|[0-9]+)(?![0-9.,])",
        "operation": "money"
      },
      {
        "name": "kwota_w_treści_potwierdzenia",
        "pattern": "\\bprzelew[^\\n\\f]{0,35} w kwocie[ \\t]+([0-9][0-9 ,.\\t]*[,.][0-9]{2}|[0-9]{1,3}(?:[ \\t][0-9]{3})+|[0-9]+)(?![0-9.,])",
        "operation": "money"
      }
    ],
    "przelew_bankowy.tytul": [
      {
        "name": "tytuł_angielski",
        "pattern": "^[ \\t]*(?:Title|Payment title|Payment details|Payment purpose|Remittance information)[ \\t]*:?[ \\t]+([^\\n\\f]+)$",
        "operation": "title"
      },
      {
        "name": "tytuł_w_cudzysłowie",
        "pattern": "^[ \\t]*(?:Tytułem|Tytuł(?: przelewu| operacji)?|Opis(?: operacji)?)[ \\t]*:?[ \\t]*(?:\\n[ \\t]*)?([„“\"][^”\"\\f]+[”\"]\\.?)",
        "operation": "title"
      },
      {
        "name": "tytuł_przelewu",
        "pattern": "^[ \\t]*(?:Tytułem|Tytuł(?: przelewu| operacji)?|Opis(?: operacji)?)(?:[ \\t]*:[ \\t]*|[ \\t]+|\\n[ \\t]*)(?:\\n[ \\t]*)?([^\\n\\f]+(?:\\n[ \\t]*(?!(?:Nr|Numer|Identyfikator|ID|Status|ZREALIZOWANO|Potwierdzenie|Dodatkowa treść|Rodzaj|Strona|Data|Kwota|Wartość|Rachunek|Typ|Kanał|Waluta|Opłata|Bank)\\b|[-=_]{3})[^\\n\\f]+)*)"
      }
    ],
    "przelew_bankowy.numer_transakcji": [
      {
        "name": "numer_referencyjny_transakcji",
        "pattern": "^[ \\t]*(?:(?:Transaction|Transfer) (?:reference|ID)|Reference number|Nr ref\\.?|(?:Numer|Nr|Identyfikator|ID) (?:transakcji|operacji|referencyjny|przelewu|referencji))(?:[ \\t]+operacji)?[ \\t]*[:\\-]?[ \\t]*(?:\\.{2,}[ \\t]*)?(?:\\n[ \\t]*)?(?!(?:Status|Kwota|Data|Rachunek|Numer|Bank|ZREALIZOWANO|Booking|Amount)\\b)([a-z0-9][a-z0-9_./\\-]+)",
        "operation": "identifier"
      }
    ],
    "przelew_bankowy.z_rachunku": [
      {
        "name": "rachunek_z_etykiety_roli",
        "pattern": "^[ \\t]*(?:Rachunek (?:obciążany|zleceniodawcy|nadawcy|płatnika)|Z rachunku)[ \\t]*:?[ \\t]*(?:\\n[ \\t]*)?(?:PL[ \\t]*)?((?:[0-9][ \\t]*){24,26})(?![ \\t]*[0-9])",
        "operation": "digits"
      },
      {
        "name": "rachunek_w_treści_potwierdzenia",
        "pattern": "\\bz rachunku[ \\t]+(?:nr[ \\t]+)?(?:PL[ \\t]*)?((?:[0-9][ \\t]*(?:\\n[ \\t]*)?){26})(?![ \\t]*[0-9])",
        "operation": "digits"
      },
      {
        "name": "rachunek_w_sekcji_roli",
        "pattern": "^[ \\t]*(?:Płatnik|Zleceniodawca|(?:Dane )?Nadawc[ay]|Dane płatnika)\\b[^\\n\\f]*(?:\\n(?!(?:[ \\t]*(?:Beneficjent|(?:Dane )?Odbiorc[ay]|Adresat przelewu|Kwota)\\b))[^\\n\\f]*){0,5}?\\n[ \\t]*(?:PL[ \\t]*)?((?:[0-9][ \\t]*){24,26})(?![ \\t]*[0-9])[ \\t]*(?=\\n|$)",
        "operation": "digits"
      }
    ],
    "przelew_bankowy.na_rachunek": [
      {
        "name": "rachunek_z_etykiety_roli",
        "pattern": "^[ \\t]*(?:Rachunek (?:odbiorcy|uznawany|beneficjenta)|Na rachunek)[ \\t]*:?[ \\t]*(?:\\n[ \\t]*)?(?:PL[ \\t]*)?((?:[0-9][ \\t]*){24,26})(?![ \\t]*[0-9])",
        "operation": "digits"
      },
      {
        "name": "rachunek_w_treści_potwierdzenia",
        "pattern": "\\bna rachunek[ \\t]+(?:nr[ \\t]+)?(?:PL[ \\t]*)?((?:[0-9][ \\t]*(?:\\n[ \\t]*)?){26})(?![ \\t]*[0-9])",
        "operation": "digits"
      },
      {
        "name": "rachunek_w_sekcji_roli",
        "pattern": "^[ \\t]*(?:Beneficjent|(?:Dane )?Odbiorc[ay]|Adresat przelewu)\\b[^\\n\\f]*(?:\\n(?!(?:[ \\t]*(?:Kwota|Wartość|Data|Nr|Numer)\\b))[^\\n\\f]*){0,5}?\\n[ \\t]*(?:PL[ \\t]*)?((?:[0-9][ \\t]*){24,26})(?![ \\t]*[0-9])[ \\t]*(?=\\n|$)",
        "operation": "digits"
      }
    ]
  },
  "classification_pages": 1,
  "exclude_heading": "^[ \\t]*(?:do faktury (?:nr|numer)\\b|FAKTURA(?: VAT| nr| numer|[ \\t]*$)|WEZWANIE DO ZAP[ŁL]ATY\\b|(?:INSTRUKCJA|PODRĘCZNIK|PRZEWODNIK) (?:UŻYTKOWNIKA|DLA|OBSŁUGI)\\b|Dane sprzedawcy[ \\t]+Dane nabywcy)",
  "exclude_page": "^[ \\t]*(?:(?:(?:Status(?: (?:operacji|transakcji|przelewu))?|Transaction status)(?:[ \\t]*:[ \\t]*|[ \\t]+))(?:do (?:realizacji|autoryzacji|podpisu)|oczekuj[ąa]c[aye]|anulowan[aye]|odrzucon[aye]|niezrealizowan[aye]|niewykonan[aye]|zaplanowan[aye]|szkic|pending|cancelled|rejected)|(?:ZLECENIE DO (?:AUTORYZACJI|PODPISU)|POTWIERDZENIE ZŁOŻENIA DYSPOZYCJI))[ \\t]*[.!]?[ \\t]*$|^[ \\t]*(?:Typ (?:produktu|operacji|transakcji)|Rodzaj (?:operacji|transakcji))[ \\t]*:?[ \\t]*(?:\\n[ \\t]*)?(?:p[łl]atno[śs][ćc] kart[ąa]|transakcja kartowa|wyp[łl]ata (?:got[óo]wki|z bankomatu))\\b",
  "builder": "transfer"
}
